var funcs = require('users/tomosdanielmorgan/ProgrammingFunctions:Landsats_days');
var segtools = require('users/tomosdanielmorgan/GlacialLakeExtraction:SegmentationClassification');
var training_class = require('users/tomosdanielmorgan/GlacialLakeExtraction:TrainClassifier');
var applying_class = require('users/tomosdanielmorgan/GlacialLakeExtraction:ApplyingClassifier');

function addIndices(image) {
var mndwi = image.normalizedDifference(['B3', 'B6']).rename('MNDWI');

var ndvi = image.normalizedDifference(['B5', 'B4']).rename('NDVI');  

var azimuth = ee.Number(image.get('SUN_AZIMUTH'));  

var elevation = ee.Number(image.get('SUN_ELEVATION'));  

var dem = ee.Image('projects/ee-tomosdanielmorgan/assets/NZ_8m_DEM').clip(image.geometry());

var hillshade = ee.Terrain.hillshade(dem, azimuth, elevation)
                  .rename('Hillshade');
                  
var slope = ee.Terrain.slope(dem)

return image.addBands([hillshade,ndvi,mndwi,slope]);
}

var all = funcs.allLandsat(area, 20, 20, 2023, 2023, 2, 2, 24, 24)
  .filter(ee.Filter.or(
    ee.Filter.and(ee.Filter.eq('WRS_PATH', 75), ee.Filter.eq('WRS_ROW', 90)),
    ee.Filter.and(ee.Filter.eq('WRS_PATH', 76), ee.Filter.eq('WRS_ROW', 90))))
  .select(['B[2-7]', 'B10'])
  .map(addIndices)

print(all);
Map.centerObject(area, 9.5);

var ROI = ee.Image('LANDSAT/LC09/C02/T1_TOA/LC09_075090_20230224').clip(area);
Map.addLayer(ROI, {bands: ['B4', 'B3', 'B2'], min: 0, max: 0.6}, 'InspectionImage');

var image = addIndices(ee.Image('LANDSAT/LC09/C02/T1_TOA/LC09_075090_20230224').select(['B[2-7]', 'B10']))

var imageCluster = segtools.segment(image);
imageCluster = imageCluster.reproject({
  scale: 30,
  crs: 'epsg:32759',
});

Map.addLayer(imageCluster, {bands: ['id']}, 'clusters');

var vectors = imageCluster.select('id').reduceToVectors({
  geometryType: 'polygon',
  reducer: ee.Reducer.countEvery(),
  scale: 30,
  maxPixels: 1e13,
});

var empty = ee.Image().byte();
var outline = empty.paint({
  featureCollection: vectors,
  color: 1,
  width: 1
});
Map.addLayer(outline, {palette: 'white'}, 'segments', false);

var trainingPoints = Water
  .merge(Ice)
  .merge(DarkVeg)
  .merge(LightVeg)
  .merge(BareSurface)
  .merge(Shadow);

var classifier = training_class.train_classifier(image, trainingPoints, 100);
print('Trained classifier:', classifier);

var classifierExplanation = classifier.explain();
print('Classifier explanation:', classifierExplanation);

var featureImportance = ee.Dictionary(classifierExplanation).get('importance');
print('Feature Importance:', featureImportance);

var img_seg = all.map(segtools.segment);
var glcm = img_seg.map(segtools.glcm_bands);
var reducing = glcm.map(segtools.reduce_bands);

var classifier_applied = applying_class.applying_classifier(classifier);
print(classifier_applied);

var Obia_collection = reducing.map(classifier_applied);
print(Obia_collection);

Map.addLayer(Obia_collection, {bands: ['classification'], min: 1, max: 6}, 'ClassifiedImage');
Map.addLayer(Obia_collection, {bands: ['classification'], min: 1, max: 2}, 'WaterImage');


var batch = require('users/fitoprincipe/geetools:batch');
batch.Download.ImageCollection.toDrive(Obia_collection, 'GlacialLakeExtraction', {
  scale: 30,
  crs: 'epsg:32759',
  maxPixels: 1e13,
  region: area
});

